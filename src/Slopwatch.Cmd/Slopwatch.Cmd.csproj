<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NetCoreVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>CLI tool for detecting LLM-generated "sloppy" code patterns in .NET projects</Description>

    <!-- dotnet tool configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>slopwatch</ToolCommandName>

    <!-- Allow running on newer .NET versions (e.g., .NET 10 when built for .NET 9) -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Slopwatch\Slopwatch.csproj" />
  </ItemGroup>

</Project>
